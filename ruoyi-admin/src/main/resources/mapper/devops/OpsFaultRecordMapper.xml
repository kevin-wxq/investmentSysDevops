<mapper namespace="com.ruoyi.devops.mapper.OpsFaultRecordMapper">
    
    <resultMap type="OpsFaultRecord" id="OpsFaultRecordResult">
        <result property="id"    column="id"    />
        <result property="systemId"    column="system_id"    />
        <result property="systemName"    column="system_name"    />
        <result property="faultTitle"    column="fault_title"    />
        <result property="faultDesc"    column="fault_desc"    />
        <result property="faultLevel"    column="fault_level"    />
        <result property="faultStatus"    column="fault_status"    />
        <result property="occurTime"    column="occur_time"    />
        <result property="discovererId"    column="discoverer_id"    />
