        delete from ops_fault_record where id = #{id}
    </delete>

    <delete id="deleteOpsFaultRecordByIds" parameterType="String">
        delete from ops_fault_record where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
