<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.devops.mapper.OpsIssueMapper">

    <resultMap type="OpsIssue" id="OpsIssueResult">
        <result property="id" column="id" />
        <result property="issueNo" column="issue_no" />
        <result property="issueType" column="issue_type" />
        <result property="systemId" column="system_id" />
        <result property="systemName" column="system_name" />
        <result property="moduleCode" column="module_code" />
        <result property="issueTitle" column="issue_title" />
        <result property="issueDesc" column="issue_desc" />
        <result property="sourceType" column="source_type" />
        <result property="impactScope" column="impact_scope" />
        <result property="priority" column="priority" />
        <result property="founder" column="founder" />
        <result property="foundTime" column="found_time" />
        <result property="ownerId" column="owner_id" />
        <result property="ownerName" column="owner_name" />
        <result property="status" column="status" />
        <result property="handleMethod" column="handle_method" />
        <result property="handleResult" column="handle_result" />
        <result property="rootCause" column="root_cause" />
        <result property="workItemId" column="work_item_id" />
        <result property="relatedBugNo" column="related_bug_no" />
        <result property="relatedReqNo" column="related_req_no" />
        <result property="relatedChangeNo" column="related_change_no" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectOpsIssueVo">
        select id, issue_no, issue_type, system_id, system_name, module_code, issue_title, issue_desc,
               source_type, impact_scope, priority, founder, found_time, owner_id, owner_name, status,
               handle_method, handle_result, root_cause, work_item_id, related_bug_no, related_req_no,
               related_change_no, del_flag, create_by, create_time, update_by, update_time, remark
        from ops_issue
    </sql>

    <select id="selectOpsIssueList" parameterType="OpsIssue" resultMap="OpsIssueResult">
        <include refid="selectOpsIssueVo"/>
        <where>
            and del_flag = '0'
            <if test="issueNo != null and issueNo != ''"> and issue_no like concat('%', #{issueNo}, '%')</if>
            <if test="issueType != null and issueType != ''"> and issue_type = #{issueType}</if>
            <if test="systemId != null"> and system_id = #{systemId}</if>
            <if test="systemName != null and systemName != ''"> and system_name like concat('%', #{systemName}, '%')</if>
            <if test="moduleCode != null and moduleCode != ''"> and module_code = #{moduleCode}</if>
            <if test="issueTitle != null and issueTitle != ''"> and issue_title like concat('%', #{issueTitle}, '%')</if>
            <if test="sourceType != null and sourceType != ''"> and source_type = #{sourceType}</if>
            <if test="priority != null and priority != ''"> and priority = #{priority}</if>
            <if test="founder != null and founder != ''"> and founder like concat('%', #{founder}, '%')</if>
            <if test="ownerName != null and ownerName != ''"> and owner_name like concat('%', #{ownerName}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="handleMethod != null and handleMethod != ''"> and handle_method = #{handleMethod}</if>
            <if test="rootCause != null and rootCause != ''"> and root_cause = #{rootCause}</if>
            <if test="params.beginTime != null and params.beginTime != ''"> and date_format(found_time, '%Y-%m-%d') &gt;= #{params.beginTime}</if>
            <if test="params.endTime != null and params.endTime != ''"> and date_format(found_time, '%Y-%m-%d') &lt;= #{params.endTime}</if>
        </where>
        order by found_time desc, id desc
    </select>

    <select id="selectOpsIssueById" parameterType="Long" resultMap="OpsIssueResult">
        <include refid="selectOpsIssueVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectMaxIssueNoByPrefix" resultType="String">
        select max(issue_no) from ops_issue where issue_no like concat(#{prefix}, '-%')
    </select>

    <insert id="insertOpsIssue" parameterType="OpsIssue" useGeneratedKeys="true" keyProperty="id">
        insert into ops_issue
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="issueNo != null">issue_no,</if>
            <if test="issueType != null">issue_type,</if>
            <if test="systemId != null">system_id,</if>
            <if test="systemName != null">system_name,</if>
            <if test="moduleCode != null">module_code,</if>
            <if test="issueTitle != null">issue_title,</if>
            <if test="issueDesc != null">issue_desc,</if>
            <if test="sourceType != null">source_type,</if>
            <if test="impactScope != null">impact_scope,</if>
            <if test="priority != null">priority,</if>
            <if test="founder != null">founder,</if>
            <if test="foundTime != null">found_time,</if>
            <if test="ownerId != null">owner_id,</if>
            <if test="ownerName != null">owner_name,</if>
            <if test="status != null">status,</if>
            <if test="handleMethod != null">handle_method,</if>
            <if test="handleResult != null">handle_result,</if>
            <if test="rootCause != null">root_cause,</if>
            <if test="workItemId != null">work_item_id,</if>
            <if test="relatedBugNo != null">related_bug_no,</if>
            <if test="relatedReqNo != null">related_req_no,</if>
            <if test="relatedChangeNo != null">related_change_no,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="issueNo != null">#{issueNo},</if>
            <if test="issueType != null">#{issueType},</if>
            <if test="systemId != null">#{systemId},</if>
            <if test="systemName != null">#{systemName},</if>
            <if test="moduleCode != null">#{moduleCode},</if>
            <if test="issueTitle != null">#{issueTitle},</if>
            <if test="issueDesc != null">#{issueDesc},</if>
            <if test="sourceType != null">#{sourceType},</if>
            <if test="impactScope != null">#{impactScope},</if>
            <if test="priority != null">#{priority},</if>
            <if test="founder != null">#{founder},</if>
            <if test="foundTime != null">#{foundTime},</if>
            <if test="ownerId != null">#{ownerId},</if>
            <if test="ownerName != null">#{ownerName},</if>
            <if test="status != null">#{status},</if>
            <if test="handleMethod != null">#{handleMethod},</if>
            <if test="handleResult != null">#{handleResult},</if>
            <if test="rootCause != null">#{rootCause},</if>
            <if test="workItemId != null">#{workItemId},</if>
            <if test="relatedBugNo != null">#{relatedBugNo},</if>
            <if test="relatedReqNo != null">#{relatedReqNo},</if>
            <if test="relatedChangeNo != null">#{relatedChangeNo},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateOpsIssue" parameterType="OpsIssue">
        update ops_issue
        <trim prefix="SET" suffixOverrides=",">
            <if test="issueNo != null">issue_no = #{issueNo},</if>
            <if test="issueType != null">issue_type = #{issueType},</if>
            <if test="systemId != null">system_id = #{systemId},</if>
            <if test="systemName != null">system_name = #{systemName},</if>
            <if test="moduleCode != null">module_code = #{moduleCode},</if>
            <if test="issueTitle != null">issue_title = #{issueTitle},</if>
            <if test="issueDesc != null">issue_desc = #{issueDesc},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="impactScope != null">impact_scope = #{impactScope},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="founder != null">founder = #{founder},</if>
            <if test="foundTime != null">found_time = #{foundTime},</if>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="ownerName != null">owner_name = #{ownerName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="handleMethod != null">handle_method = #{handleMethod},</if>
            <if test="handleResult != null">handle_result = #{handleResult},</if>
            <if test="rootCause != null">root_cause = #{rootCause},</if>
            <if test="workItemId != null">work_item_id = #{workItemId},</if>
            <if test="relatedBugNo != null">related_bug_no = #{relatedBugNo},</if>
            <if test="relatedReqNo != null">related_req_no = #{relatedReqNo},</if>
            <if test="relatedChangeNo != null">related_change_no = #{relatedChangeNo},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteOpsIssueById" parameterType="Long">
        update ops_issue set del_flag = '1', update_time = sysdate() where id = #{id}
    </update>

    <update id="deleteOpsIssueByIds" parameterType="String">
        update ops_issue set del_flag = '1', update_time = sysdate()
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
