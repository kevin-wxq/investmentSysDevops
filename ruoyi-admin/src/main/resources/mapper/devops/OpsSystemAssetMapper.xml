    <sql id="selectOpsSystemAssetVo">select id, system_code, system_name, system_type, importance_level, system_url, server_ip, db_type, dev_lang, department, business_owner, tech_owner_id, go_live_date, system_status, order_num, create_time, create_by, update_by, update_time, remark from ops_system_asset</sql>
    <select id="selectOpsSystemAssetList" parameterType="OpsSystemAsset" resultMap="OpsSystemAssetResult">
        <include refid="selectOpsSystemAssetVo"/><where>
            <if test="systemCode != null and systemCode != ''"> and system_code like concat('%', #{systemCode}, '%')</if>
            <if test="systemName != null and systemName != ''"> and system_name like concat('%', #{systemName}, '%')</if>
            <if test="systemType != null and systemType != ''"> and system_type like concat('%', #{systemType}, '%')</if>
            <if test="importanceLevel != null and importanceLevel != ''"> and importance_level like concat('%', #{importanceLevel}, '%')</if>
            <if test="systemUrl != null and systemUrl != ''"> and system_url like concat('%', #{systemUrl}, '%')</if>
            <if test="serverIp != null and serverIp != ''"> and server_ip like concat('%', #{serverIp}, '%')</if>
            <if test="dbType != null and dbType != ''"> and db_type like concat('%', #{dbType}, '%')</if>
            <if test="devLang != null and devLang != ''"> and dev_lang like concat('%', #{devLang}, '%')</if>
            <if test="department != null and department != ''"> and department like concat('%', #{department}, '%')</if>
            <if test="businessOwner != null and businessOwner != ''"> and business_owner like concat('%', #{businessOwner}, '%')</if>
            <if test="techOwnerId != null"> and tech_owner_id = #{techOwnerId}</if>
            <if test="goLiveDate != null"> and go_live_date = #{goLiveDate}</if>
            <if test="systemStatus != null and systemStatus != ''"> and system_status like concat('%', #{systemStatus}, '%')</if>
            <if test="orderNum != null"> and order_num = #{orderNum}</if>
        </where>
    </select>
    <select id="selectOpsSystemAssetById" parameterType="Long" resultMap="OpsSystemAssetResult">
        <include refid="selectOpsSystemAssetVo"/> where id = #{id}
    </select>
    <select id="selectMaxSystemCodeByPrefix" parameterType="String" resultType="String">
        select system_code
        from ops_system_asset
        where system_code like concat(#{prefix}, '-%')
        order by cast(substring_index(system_code, '-', -1) as unsigned) desc
        limit 1
    </select>
    <insert id="insertOpsSystemAsset" parameterType="OpsSystemAsset" useGeneratedKeys="true" keyProperty="id">
        insert into ops_system_asset <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="systemCode != null">system_code,</if>
            <if test="systemName != null">system_name,</if>
