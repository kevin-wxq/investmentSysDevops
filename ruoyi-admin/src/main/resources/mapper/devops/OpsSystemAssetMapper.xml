    </update>
    <delete id="deleteOpsSystemAssetById" parameterType="Long">delete from ops_system_asset where id=#{id}</delete>
    <delete id="deleteOpsSystemAssetByIds" parameterType="String">
        delete from ops_system_asset where id in <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
