<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.devops.mapper.HtBugRecordMapper">

    <resultMap type="HtBugRecord" id="HtBugRecordResult">
        <result property="id" column="id" />
        <result property="bugNo" column="bug_no" />
        <result property="requirementId" column="requirement_id" />
        <result property="requirementNo" column="requirement_no" />
        <result property="systemId" column="system_id" />
        <result property="systemName" column="system_name" />
        <result property="bugTitle" column="bug_title" />
        <result property="bugDesc" column="bug_desc" />
        <result property="severity" column="severity" />
        <result property="priority" column="priority" />
        <result property="status" column="status" />
        <result property="founder" column="founder" />
        <result property="foundTime" column="found_time" />
        <result property="ownerId" column="owner_id" />
        <result property="ownerName" column="owner_name" />
        <result property="fixPlan" column="fix_plan" />
        <result property="fixResult" column="fix_result" />
        <result property="planFixTime" column="plan_fix_time" />
        <result property="actualFixTime" column="actual_fix_time" />
        <result property="tester" column="tester" />
        <result property="testResult" column="test_result" />
        <result property="closeTime" column="close_time" />
        <result property="closeDesc" column="close_desc" />
        <result property="workItemId" column="work_item_id" />
        <result property="delFlag" column="del_flag" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectHtBugRecordVo">
        select id, bug_no, requirement_id, requirement_no, system_id, system_name, bug_title, bug_desc,
               severity, priority, status, founder, found_time, owner_id, owner_name, fix_plan, fix_result,
               plan_fix_time, actual_fix_time, tester, test_result, close_time, close_desc, work_item_id,
               del_flag, create_by, create_time, update_by, update_time, remark
        from ht_bug_record
    </sql>

    <select id="selectHtBugRecordList" parameterType="HtBugRecord" resultMap="HtBugRecordResult">
        <include refid="selectHtBugRecordVo"/>
        <where>
            and del_flag = '0'
            <if test="bugNo != null and bugNo != ''"> and bug_no like concat('%', #{bugNo}, '%')</if>
            <if test="requirementNo != null and requirementNo != ''"> and requirement_no like concat('%', #{requirementNo}, '%')</if>
            <if test="systemId != null"> and system_id = #{systemId}</if>
            <if test="systemName != null and systemName != ''"> and system_name like concat('%', #{systemName}, '%')</if>
            <if test="bugTitle != null and bugTitle != ''"> and bug_title like concat('%', #{bugTitle}, '%')</if>
            <if test="severity != null and severity != ''"> and severity = #{severity}</if>
            <if test="priority != null and priority != ''"> and priority = #{priority}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="founder != null and founder != ''"> and founder like concat('%', #{founder}, '%')</if>
            <if test="ownerName != null and ownerName != ''"> and owner_name like concat('%', #{ownerName}, '%')</if>
            <if test="tester != null and tester != ''"> and tester like concat('%', #{tester}, '%')</if>
            <if test="testResult != null and testResult != ''"> and test_result = #{testResult}</if>
        </where>
        order by found_time desc, id desc
    </select>

    <select id="selectHtBugRecordById" parameterType="Long" resultMap="HtBugRecordResult">
        <include refid="selectHtBugRecordVo"/>
        where id = #{id} and del_flag = '0'
    </select>

    <select id="selectMaxBugNoByPrefix" resultType="String">
        select max(bug_no) from ht_bug_record where bug_no like concat(#{prefix}, '-%')
    </select>

    <insert id="insertHtBugRecord" parameterType="HtBugRecord" useGeneratedKeys="true" keyProperty="id">
        insert into ht_bug_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bugNo != null">bug_no,</if>
            <if test="requirementId != null">requirement_id,</if>
            <if test="requirementNo != null">requirement_no,</if>
            <if test="systemId != null">system_id,</if>
            <if test="systemName != null">system_name,</if>
            <if test="bugTitle != null">bug_title,</if>
            <if test="bugDesc != null">bug_desc,</if>
            <if test="severity != null">severity,</if>
            <if test="priority != null">priority,</if>
            <if test="status != null">status,</if>
            <if test="founder != null">founder,</if>
            <if test="foundTime != null">found_time,</if>
            <if test="ownerId != null">owner_id,</if>
            <if test="ownerName != null">owner_name,</if>
            <if test="fixPlan != null">fix_plan,</if>
            <if test="fixResult != null">fix_result,</if>
            <if test="planFixTime != null">plan_fix_time,</if>
            <if test="actualFixTime != null">actual_fix_time,</if>
            <if test="tester != null">tester,</if>
            <if test="testResult != null">test_result,</if>
            <if test="closeTime != null">close_time,</if>
            <if test="closeDesc != null">close_desc,</if>
            <if test="workItemId != null">work_item_id,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="bugNo != null">#{bugNo},</if>
            <if test="requirementId != null">#{requirementId},</if>
            <if test="requirementNo != null">#{requirementNo},</if>
            <if test="systemId != null">#{systemId},</if>
            <if test="systemName != null">#{systemName},</if>
            <if test="bugTitle != null">#{bugTitle},</if>
            <if test="bugDesc != null">#{bugDesc},</if>
            <if test="severity != null">#{severity},</if>
            <if test="priority != null">#{priority},</if>
            <if test="status != null">#{status},</if>
            <if test="founder != null">#{founder},</if>
            <if test="foundTime != null">#{foundTime},</if>
            <if test="ownerId != null">#{ownerId},</if>
            <if test="ownerName != null">#{ownerName},</if>
            <if test="fixPlan != null">#{fixPlan},</if>
            <if test="fixResult != null">#{fixResult},</if>
            <if test="planFixTime != null">#{planFixTime},</if>
            <if test="actualFixTime != null">#{actualFixTime},</if>
            <if test="tester != null">#{tester},</if>
            <if test="testResult != null">#{testResult},</if>
            <if test="closeTime != null">#{closeTime},</if>
            <if test="closeDesc != null">#{closeDesc},</if>
            <if test="workItemId != null">#{workItemId},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateHtBugRecord" parameterType="HtBugRecord">
        update ht_bug_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="bugNo != null">bug_no = #{bugNo},</if>
            <if test="requirementId != null">requirement_id = #{requirementId},</if>
            <if test="requirementNo != null">requirement_no = #{requirementNo},</if>
            <if test="systemId != null">system_id = #{systemId},</if>
            <if test="systemName != null">system_name = #{systemName},</if>
            <if test="bugTitle != null">bug_title = #{bugTitle},</if>
            <if test="bugDesc != null">bug_desc = #{bugDesc},</if>
            <if test="severity != null">severity = #{severity},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="status != null">status = #{status},</if>
            <if test="founder != null">founder = #{founder},</if>
            <if test="foundTime != null">found_time = #{foundTime},</if>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="ownerName != null">owner_name = #{ownerName},</if>
            <if test="fixPlan != null">fix_plan = #{fixPlan},</if>
            <if test="fixResult != null">fix_result = #{fixResult},</if>
            <if test="planFixTime != null">plan_fix_time = #{planFixTime},</if>
            <if test="actualFixTime != null">actual_fix_time = #{actualFixTime},</if>
            <if test="tester != null">tester = #{tester},</if>
            <if test="testResult != null">test_result = #{testResult},</if>
            <if test="closeTime != null">close_time = #{closeTime},</if>
            <if test="closeDesc != null">close_desc = #{closeDesc},</if>
            <if test="workItemId != null">work_item_id = #{workItemId},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteHtBugRecordById" parameterType="Long">
        update ht_bug_record set del_flag = '1', update_time = sysdate() where id = #{id}
    </update>

    <update id="deleteHtBugRecordByIds" parameterType="String">
        update ht_bug_record set del_flag = '1', update_time = sysdate()
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
