<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.devops.mapper.WeeklyDailyOperationMapper">
    
    <resultMap type="WeeklyDailyOperation" id="WeeklyDailyOperationResult">
        <result property="id"    column="id"    />
        <result property="taskId"    column="task_id"    />
        <result property="operationType"    column="operation_type"    />
        <result property="operationName"    column="operation_name"    />
        <result property="executor"    column="executor"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectWeeklyDailyOperationVo">
        select id, task_id, operation_type, operation_name, executor, create_time, create_by, update_by, update_time, remark from weekly_daily_operation
    </sql>

    <select id="selectWeeklyDailyOperationList" parameterType="WeeklyDailyOperation" resultMap="WeeklyDailyOperationResult">
        <include refid="selectWeeklyDailyOperationVo"/>
        <where>  
            <if test="taskId != null "> and task_id = #{taskId}</if>
            <if test="operationType != null  and operationType != ''"> and operation_type = #{operationType}</if>
            <if test="operationName != null  and operationName != ''"> and operation_name like concat('%', #{operationName}, '%')</if>
            <if test="executor != null  and executor != ''"> and executor = #{executor}</if>
            <if test="createTime != null "> and create_time = #{createTime}</if>
        </where>
    </select>
    
    <select id="selectWeeklyDailyOperationById" parameterType="Long" resultMap="WeeklyDailyOperationResult">
        <include refid="selectWeeklyDailyOperationVo"/>
        where id = #{id}
    </select>

    <insert id="insertWeeklyDailyOperation" parameterType="WeeklyDailyOperation" useGeneratedKeys="true" keyProperty="id">
        insert into weekly_daily_operation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskId != null">task_id,</if>
            <if test="operationType != null">operation_type,</if>
            <if test="operationName != null">operation_name,</if>
            <if test="executor != null">executor,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskId != null">#{taskId},</if>
            <if test="operationType != null">#{operationType},</if>
            <if test="operationName != null">#{operationName},</if>
            <if test="executor != null">#{executor},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateWeeklyDailyOperation" parameterType="WeeklyDailyOperation">
        update weekly_daily_operation
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskId != null">task_id = #{taskId},</if>
            <if test="operationType != null">operation_type = #{operationType},</if>
            <if test="operationName != null">operation_name = #{operationName},</if>
            <if test="executor != null">executor = #{executor},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteWeeklyDailyOperationById" parameterType="Long">
        delete from weekly_daily_operation where id = #{id}
    </delete>

    <delete id="deleteWeeklyDailyOperationByIds" parameterType="String">
        delete from weekly_daily_operation where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>